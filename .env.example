# Copy to .env.local and replace placeholders with local development values.
# Never commit real credentials or use this file to store them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack app configuration required for OAuth, webhook verification, and sync worker access.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_OAUTH_STATE_SECRET=replace-with-32-plus-character-random-secret
SLACK_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SLACK_SYNC_SECRET=replace-with-32-plus-character-random-secret
CRON_SECRET=replace-with-a-random-cron-secret

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# QStash is used to verify uploaded inquiry reference images asynchronously.
# Without a token, local development verifies them inline.
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
